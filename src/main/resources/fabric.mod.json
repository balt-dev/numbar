{
	"schemaVersion": 1,
	"id": "numbar",
	"version": "${version}",
	"name": "Numbar",
	"description": "Makes durability bars, progress bars, XP, etc. show numeric values!",
	"authors": [
		"baltdev"
	],
	"contact": {
		"homepage": "https://github.com/balt-dev/numbar"
	},
	"license": "MIT",
	"icon": "assets/numbar/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xyz.numbar.NumbarMain"
		],
		"client": [
			"xyz.numbar.NumbarClient"
		],
		"modmenu": [
			"xyz.numbar.NumbarModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "numbar.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.6",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"accessWidener" : "numbar.accesswidener"
}